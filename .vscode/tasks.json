{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar Servidor RH BRINNERCAS (Puerto 3005)",
      "type": "shell",
      "command": "node",
      "args": ["server.js"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Sincronizar Google Drive y Google Sheets",
      "type": "shell",
      "command": "node",
      "args": ["scripts/sync_drive_rh_brinnercas.js"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
